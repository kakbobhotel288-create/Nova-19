def show_performance():

    print("\n" + "=" * 72)
    print("DEMO PERFORMANCE")
    print("=" * 72)

    if len(trades_df) == 0:

        print("No completed demo trades yet.")
        return

    results = trades_df["result"].astype(str).str.upper()

    wins = (results == "WIN").sum()
    losses = (results == "LOSS").sum()
    pushes = (results == "PUSH").sum()

    settled = wins + losses

    if settled > 0:
        win_rate = wins / settled * 100
    else:
        win_rate = 0

    net_return = pd.to_numeric(
        trades_df["demo_return"],
        errors="coerce"
    ).fillna(0).sum()

    print(f"Trades:       {len(trades_df)}")
    print(f"Wins:         {wins}")
    print(f"Losses:       {losses}")
    print(f"Pushes:       {pushes}")
    print(f"Win rate:     {win_rate:.2f}%")
    print(f"Break-even:   {100/(1+PAYOUT):.2f}%")
    print(f"Net return:   {net_return:.2f} units")

    # ------------------------------------------------------------
    # CALL
    # ------------------------------------------------------------

    call = trades_df[
        trades_df["signal"].astype(str).str.upper() == "CALL"
    ]

    if len(call) > 0:

        cw = (
            call["result"]
            .astype(str)
            .str.upper()
            .eq("WIN")
            .sum()
        )

        cl = (
            call["result"]
            .astype(str)
            .str.upper()
            .eq("LOSS")
            .sum()
        )

        cs = cw + cl

        print(
            f"CALL:         {len(call)} trades | "
            f"{cw}W / {cl}L | "
            f"{(cw/cs*100 if cs else 0):.2f}%"
        )

    # ------------------------------------------------------------
    # PUT
    # ------------------------------------------------------------

    put = trades_df[
        trades_df["signal"].astype(str).str.upper() == "PUT"
    ]

    if len(put) > 0:

        pw = (
            put["result"]
            .astype(str)
            .str.upper()
            .eq("WIN")
            .sum()
        )

        pl = (
            put["result"]
            .astype(str)
            .str.upper()
            .eq("LOSS")
            .sum()
        )

        ps = pw + pl

        print(
            f"PUT:          {len(put)} trades | "
            f"{pw}W / {pl}L | "
            f"{(pw/ps*100 if ps else 0):.2f}%"
        )

    print("=" * 72)


