def load_csv(path, columns):

    if os.path.exists(path):

        try:
            df = pd.read_csv(path)

            for c in columns:
                if c not in df.columns:
                    df[c] = ""

            return df

        except Exception:
            pass

    return pd.DataFrame(columns=columns)


