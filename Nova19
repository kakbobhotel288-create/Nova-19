def run_monitor():

    print("\nStarting live NOVA V19 monitor...")
    print("The clock updates every second.")
    print("NOVA checks for a new completed 5-minute candle.")
    print("Press Ctrl+C to stop.\n")

    last_processed_candle = None

    while True:

        try:

            # ----------------------------------------------------
            # REAL-TIME CLOCK
            # ----------------------------------------------------

            current_utc = now_utc()
            current_local = now_local()

            # ----------------------------------------------------
            # GET LATEST SIGNAL
            # ----------------------------------------------------

            sig = get_latest_signal()

            candle_time = sig["candle_time"]

            # ----------------------------------------------------
            # Only log / announce NEW candles
            # ----------------------------------------------------

            is_new = (
                last_processed_candle is None
                or candle_time != last_processed_candle
            )

            if is_new:

                last_processed_candle = candle_time

                log_signal(sig)

            # ----------------------------------------------------
            # DISPLAY
            # ----------------------------------------------------

            clear_output(wait=True)

            print("=" * 72)
            print("NOVA V19 — POCKET OPTION DEMO")
            print("=" * 72)

            print(
                f"Live clock:   "
                f"{current_local.strftime('%Y-%m-%d %I:%M:%S %p %Z')}"
            )

            print(
                f"UTC clock:    "
                f"{current_utc.strftime('%Y-%m-%d %H:%M:%S UTC')}"
            )

            print("-" * 72)

            print(
                f"Candle:       {fmt_local(candle_time)}"
            )

            print(
                f"Candle UTC:   {fmt_utc(candle_time)}"
            )

            print(
                f"Price:        {sig['price']:.6f}"
            )

            print(
                f"P(UP):        {sig['p_up']*100:.2f}%"
            )

            print(
                f"P(DOWN):      {sig['p_down']*100:.2f}%"
            )

            print(
                f"Signal:       {sig['signal']}"
            )

            print(
                f"Expiry:       {fmt_local(sig['expiry_time'])}"
            )

            print(
                f"Expiry UTC:   {fmt_utc(sig['expiry_time'])}"
            )

            print("=" * 72)

            if sig["signal"] == "CALL":

                print("\n>>> CALL SIGNAL <<<")

            elif sig["signal"] == "PUT":

                print("\n>>> PUT SIGNAL <<<")

            else:

                print("\n>>> WAIT / NO TRADE <<<")

            print("\nPocket Option execution: MANUAL")
            print("DEMO ACCOUNT ONLY — NO AUTOMATIC ORDER PLACEMENT")

            show_performance()

            print("\n" + "=" * 72)
            print(
                f"Next data check in {REFRESH_SECONDS} seconds..."
            )
            print(
                "A new signal is generated only after a new "
                "completed 5-minute candle appears."
            )
            print("=" * 72)

            time.sleep(REFRESH_SECONDS)

        except KeyboardInterrupt:

            clear_output(wait=True)

            print("=" * 72)
            print("NOVA V19 MONITOR STOPPED")
            print("=" * 72)

            break

        except Exception as e:

            clear_output(wait=True)

            print("=" * 72)
            print("NOVA V19 — TEMPORARY DATA ERROR")
            print("=" * 72)

            print(
                f"Live clock: {now_local().strftime('%Y-%m-%d %I:%M:%S %p %Z')}"
            )

            print(f"\nError: {e}")

