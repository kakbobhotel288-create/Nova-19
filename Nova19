# ================================================================
# TRAIN V19 MODEL
# ================================================================

print("\nDownloading EUR/USD training data...")

data = download_data()

print(f"Downloaded rows: {len(data):,}")

features = build_features(data)

# ------------------------------------------------------------
# TARGET
#
# UP   = next close > current close
# DOWN = next close < current close
# TIE  = next close == current close
# ------------------------------------------------------------

next_close = data["close"].shift(-1)

features["target"] = np.where(
    next_close > data["close"],
    1,
    np.where(
        next_close < data["close"],
        0,
        np.nan
    )
)

# Target endpoint = next candle timestamp
features["target_end"] = pd.Series(
    data.index.to_series().shift(-1),
    index=data.index
)

# ------------------------------------------------------------
# MODEL READY
# ------------------------------------------------------------

model_df = features[
    FEATURES +
    ["target", "target_end"]
].copy()

model_df = model_df.dropna(subset=FEATURES + ["target", "target_end"])

model_df["target"] = model_df["target"].astype(int)

# Only binary UP/DOWN rows
model_df = model_df[
    model_df["target"].isin([0, 1])
].copy()

# ------------------------------------------------------------
# CHRONOLOGICAL HOLDOUT
# ------------------------------------------------------------

split_idx = int(
    len(model_df) * (1 - TRAIN_HOLDOUT)
)

holdout_start = model_df.index[split_idx]

# TRUE PURGE:
# Training labels must finish BEFORE holdout begins.
train_df = model_df[
    model_df["target_end"] < holdout_start
].copy()

print(f"Model-ready rows: {len(model_df):,}")
print(f"Training rows:    {len(train_df):,}")
print(f"Holdout start:    {holdout_start}")

# ------------------------------------------------------------
# FROZEN V19 MODEL
# ------------------------------------------------------------

model = Pipeline([
    (
        "scaler",
        StandardScaler()
    ),
    (
        "classifier",
        LogisticRegression(
            C=0.10,
            max_iter=3000,
            solver="lbfgs",
            random_state=42
        )
    )
])

model.fit(
    train_df[FEATURES],
    train_df["target"]
)

print("NOVA V19 model loaded/trained.")


