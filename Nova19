def now_utc():
    return datetime.now(timezone.utc)


def now_local():
    return datetime.now(LOCAL_TZ)


def fmt_local(dt):
    return dt.astimezone(LOCAL_TZ).strftime(
        "%Y-%m-%d %I:%M:%S %p %Z"
    )


def fmt_utc(dt):
    return dt.astimezone(timezone.utc).strftime(
        "%Y-%m-%d %H:%M:%S UTC"
    )


# ================================================================
# GET LATEST COMPLETED CANDLE
# ================================================================

def get_latest_signal():

    df = download_data()

    feat = build_features(df)

    # ------------------------------------------------------------
    # IMPORTANT:
    #
    # Yahoo can contain the currently-forming candle.
    # We use the SECOND-TO-LAST candle as the latest
    # completed candle.
    # ------------------------------------------------------------

    if len(feat) < 3:
        raise RuntimeError(
            "Not enough candles returned."
        )

    completed_time = feat.index[-2]

    row = feat.loc[completed_time]

    # ------------------------------------------------------------
    # Verify features
    # ------------------------------------------------------------

    if row[FEATURES].isna().any():

        missing = row[FEATURES].index[
            row[FEATURES].isna()
        ].tolist()

        raise RuntimeError(
            f"Latest candle has missing features: {missing}"
        )

    X = pd.DataFrame(
        [row[FEATURES].values],
        columns=FEATURES
    )

    probabilities = model.predict_proba(X)[0]

    classes = model.classes_

    p_down = float(
        probabilities[
            list(classes).index(0)
        ]
    )

    p_up = float(
        probabilities[
            list(classes).index(1)
        ]
    )

    # ------------------------------------------------------------
    # V19 SIGNAL LOGIC
    # ------------------------------------------------------------

    if p_up >= SIGNAL_THRESHOLD:

        signal = "CALL"

    elif p_down >= SIGNAL_THRESHOLD:

        signal = "PUT"

    else:

        signal = "WAIT"

    # ------------------------------------------------------------
    # Expiry = next 5-minute candle
    # ------------------------------------------------------------

    expiry_time = completed_time + timedelta(
        minutes=5
    )

    return {
        "candle_time": completed_time,
        "price": float(df.loc[completed_time, "close"]),
        "p_up": p_up,
        "p_down": p_down,
        "signal": signal,
        "expiry_time": expiry_time,
    }


# ================================================================
# LOG SIGNAL
# ================================================================

def log_signal(sig):

    global signals_df

    candle_time = sig["candle_time"]

    # Prevent duplicate signal rows
    if len(signals_df) > 0:

        existing = pd.to_datetime(
            signals_df["candle_time_utc"],
            errors="coerce",
            utc=True
        )

        if candle_time in set(existing.dropna()):
            return False

    signal_id = (
        datetime.now(timezone.utc).strftime(
            "%Y%m%d%H%M%S"
        )
    )

    new_row = {
        "signal_id": signal_id,
        "candle_time_utc": fmt_utc(candle_time),
        "candle_time_local": fmt_local(candle_time),
        "price": sig["price"],
        "p_up": sig["p_up"],
        "p_down": sig["p_down"],
        "signal": sig["signal"],
        "expiry_time_utc": fmt_utc(
            sig["expiry_time"]
        ),
        "expiry_time_local": fmt_local(
            sig["expiry_time"]
        ),
    }

    signals_df = pd.concat(
        [
            signals_df,
            pd.DataFrame([new_row])
        ],
        ignore_index=True
    )

    signals_df.to_csv(
        SIGNAL_LOG_FILE,
        index=False
    )

    return True


